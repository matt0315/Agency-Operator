# Agency Operator
# Copy to .env.local. Leave secrets empty to run the full demo in mock mode.

# mock: never call OpenAI or Higgsfield.
# live: call a provider only when its credentials are present.
# unset: same as live — missing credentials fall back to mock per provider.
APP_MODE=mock

# OpenAI Responses API. The key is read only on the server.
# Official model guidance documents gpt-6-astra as a Responses model with Structured Outputs.
# Override only if your account does not have that model.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Higgsfield API credentials. Server-side only.
# Authorization header format: Key ${HF_API_KEY_ID}:${HF_API_KEY_SECRET}
# Create them in the Higgsfield console. Never put them in client code.
HF_API_KEY_ID=
HF_API_KEY_SECRET=
# OpenAPI server and model pages use this base. Do not point the browser at it.
HF_API_BASE=https://api.higgsfield.ai

# Optional shared secret for the local webhook receiver.
# If empty, POST /api/higgsfield/webhook rejects every request.
HF_WEBHOOK_TOKEN=

# Application-level poll timeout in milliseconds. This is not a provider status.
POLL_TIMEOUT_MS=180000

# Local sqlite file. The repository interface is the Postgres seam.
DATABASE_PATH=data/agency-operator.sqlite
ASSET_DIR=data/assets

# Defaults for new jobs. Basis points: 1000 = 10%.
DEFAULT_SOURCE_FEE_BPS=1000
DEFAULT_CONTINGENCY_BPS=2000
DEFAULT_TARGET_MARGIN_BPS=5500
DEFAULT_MAX_PRODUCTION_MICROS=40000000
